<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/campaignsTitleText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F5F5F5"
        android:gravity="center"
        android:padding="14dp"
        android:text="@string/campaigns_title"
        android:textSize="18sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/createCampaignButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/campaignsTitleText"
        android:text="@string/create_campaign_button"
        android:layout_margin="12dp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/campaignsRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/createCampaignButton"
        android:padding="8dp" />

    <TextView
        android:id="@+id/emptyCampaignsText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:text="@string/empty_campaigns"
        android:textSize="16sp"
        android:visibility="gone" />

</RelativeLayout>
